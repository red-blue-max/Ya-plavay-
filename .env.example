# Адрес сайта (для canonical, sitemap, Open Graph). На Vercel можно не задавать — возьмётся адрес проекта.
SITE_URL=https://ya-plavau.ru

# false — демо: noindex на всех страницах и Disallow: / в robots.txt.
# true  — боевой сайт: индексация разрешена.
PUBLIC_INDEXING=false

# ID счётчика Яндекс.Метрики. Пусто — Метрика и баннер cookie не подключаются.
PUBLIC_YM_ID=

# Куда отправлять форму записи. По умолчанию /api/lead.php (Timeweb).
# На Vercel по умолчанию пусто = демо-режим: форма проверяет поля, но данные никуда не уходят.
# PUBLIC_FORM_ENDPOINT=/api/lead.php
