# ===== Я Плаваю — настройки Apache (Timeweb) =====
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- HTTPS и домен без www ---
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- 301-редиректы со старого сайта на Tilda (с косой чертой и без) ---
  RewriteRule ^about/?$                    /o-klube/                 [R=301,L]
  RewriteRule ^treneri/?$                  /o-klube/#komanda         [R=301,L,NE]
  RewriteRule ^trenirovki/?$               /zanyatiya/               [R=301,L]
  RewriteRule ^individualnye-zanyatiya/?$  /zanyatiya/#individualnye [R=301,L,NE]
  RewriteRule ^gruppovye-zanyatiya/?$      /zanyatiya/#gruppovye     [R=301,L,NE]
  RewriteRule ^halliwick-terapiya/?$       /zanyatiya/#halliwick     [R=301,L,NE]
  RewriteRule ^parafree/?$                 /zanyatiya/#parafridajving [R=301,L,NE]
  RewriteRule ^watsu/?$                    /zanyatiya/#watsu         [R=301,L,NE]
  RewriteRule ^page70040685\.html$         /zanyatiya/               [R=301,L]
  RewriteRule ^stoimost/?$                 /bassejny/#ceny           [R=301,L,NE]
  RewriteRule ^galereya/?$                 /sorevnovaniya/#galereya  [R=301,L,NE]
  RewriteRule ^lager2/?$                   /sorevnovaniya/           [R=301,L]

  # --- Косая черта в конце для страниц-папок ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

# --- Безопасность ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain application/xml application/manifest+json
</IfModule>

# --- Кеш: файлы с хешем в имени (папка _astro) — на год, HTML — без кеша ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpe?g|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
AddType font/woff2 .woff2
AddType image/avif .avif
AddType application/manifest+json .webmanifest
