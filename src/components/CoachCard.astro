---
// Карточка тренера: фото (или заглушка), ФИО, роль, 1–2 регалии.
// Полный список образования и опыта раскрывается по кнопке (<details> — работает без JS).
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  coach: {
    name: string; role: string; photo?: string; highlights: string[];
    education: string[]; extra: string[]; experience: string[];
  };
  /** Показывать раскрывающийся список дипломов */
  details?: boolean;
}
const { coach, details = true } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../images/coaches/*.{jpg,jpeg,png,webp}');
const key = coach.photo ? `../images/coaches/${coach.photo}` : null;
const photo = key && images[key] ? (await images[key]()).default : null;
const initials = coach.name.split(' ').slice(0, 2).map((w) => w[0]).join('');
const [last, ...rest] = coach.name.split(' ');
const sections = [
  ['Образование', coach.education],
  ['Дополнительное образование', coach.extra],
  ['Опыт работы', coach.experience],
] as const;
---

<article class="card flex h-full flex-col overflow-hidden">
  <div class="relative aspect-[4/5] overflow-hidden bg-gradient-to-b from-sky-soft to-foam">
    {photo ? (
      <Picture
        src={photo}
        alt={`${coach.name}. ${coach.role}`}
        formats={['avif', 'webp']}
        widths={[280, 420, 600]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
        width={600}
        height={750}
        fit="cover"
        position="attention"
        quality={74}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="flex h-full items-center justify-center" role="img" aria-label={`Фото ${coach.name} скоро появится`}>
        <span class="flex size-28 items-center justify-center rounded-full bg-white/80 font-display text-3xl font-semibold text-sea">{initials}</span>
      </div>
    )}
    <svg class="absolute inset-x-0 bottom-0 h-6 w-full text-white" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 14c60-12 120-12 200 0s140 12 200 0v10H0z" /></svg>
  </div>
  <div class="flex flex-1 flex-col p-5 pt-3 sm:p-6 sm:pt-3">
    <h3 class="text-lg sm:text-xl">{last}<br /><span class="font-sans text-base font-semibold text-ink-soft">{rest.join(' ')}</span></h3>
    <p class="mt-2 text-sm font-semibold text-sea">{coach.role}</p>
    <ul class="mt-3 grid gap-1.5 text-[0.95rem]">
      {coach.highlights.map((h) => (
        <li class="flex gap-2"><Icon name="star" size={18} class="mt-0.5 shrink-0 text-sun" />{h}</li>
      ))}
    </ul>
    {details && (
      <details class="group mt-auto pt-4">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 font-semibold text-sea [&::-webkit-details-marker]:hidden">
          Образование и опыт
          <Icon name="down" size={18} class="transition-transform group-open:rotate-180" />
        </summary>
        <div class="mt-2 grid gap-4 text-[0.95rem] text-ink-soft">
          {sections.filter(([, items]) => items.length).map(([title, items]) => (
            <div>
              <p class="font-semibold text-ink">{title}</p>
              <ul class="mt-1 grid list-disc gap-1 pl-5 marker:text-aqua">
                {items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </details>
    )}
  </div>
</article>
