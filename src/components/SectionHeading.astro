---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  id?: string;
  level?: 'h1' | 'h2';
}
const { eyebrow, title, lead, align = 'left', id, level = 'h2' } = Astro.props;
const Tag = level;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {eyebrow && (
    <p class:list={['eyebrow', align === 'center' && 'justify-center']}>
      <span class="lane inline-block w-8" aria-hidden="true"></span>{eyebrow}
    </p>
  )}
  <Tag id={id} class="mt-3">{title}</Tag>
  {lead && <p class="lead mt-4">{lead}</p>}
  <slot />
</div>
