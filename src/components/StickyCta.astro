---
import Icon from './Icon.astro';
import { getSite } from '../lib/site';
interface Props { signupHref: string }
const { signupHref } = Astro.props;
const site = await getSite();
---

<!-- Липкая панель записи: только на мобильных. Прячется, когда форма записи на экране. -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink/10 bg-cream/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-300 sm:hidden"
  data-sticky-cta
>
  <div class="flex gap-2">
    <a href={signupHref} class="btn btn-primary flex-1">Записаться</a>
    <a href={site.phoneHref} class="btn btn-secondary !px-0 size-12 shrink-0" aria-label={`Позвонить: ${site.phone}`}><Icon name="phone" /></a>
    <a href={site.telegram} rel="noopener" class="btn btn-secondary !px-0 size-12 shrink-0" aria-label="Написать в Telegram"><Icon name="telegram" /></a>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const form = document.getElementById('zapis');
  if (bar && form && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      bar.style.transform = e.isIntersecting ? 'translateY(110%)' : '';
      bar.toggleAttribute('inert', e.isIntersecting);
    }).observe(form);
  }
</script>
