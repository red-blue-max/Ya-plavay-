---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { photos } from '../../lib/photos';

const tasks = [
  'Гидрореабилитация (содействие реабилитационным мероприятиям)',
  'Подготовка детей к спортивному плаванию',
  'Соревнования по плаванию для всех детей',
  'Приобщение к физической культуре',
];
---

<section class="section" aria-labelledby="about-title">
  <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="order-2 grid grid-cols-5 gap-4 lg:order-1" data-reveal>
      <Photo src={photos.podderzhka.src} alt={photos.podderzhka.alt} ratio="3/4" frame="sun" position="attention" class="col-span-3" sizes="(min-width: 1024px) 28vw, 55vw" />
      <Photo src={photos.obyatiya.src} alt={photos.obyatiya.alt} ratio="3/4" frame="sky" position="attention" class="col-span-2 mt-16" sizes="(min-width: 1024px) 18vw, 38vw" widths={[240, 360, 560]} />
    </div>
    <div class="order-1 lg:order-2" data-reveal>
      <p class="eyebrow"><span class="lane inline-block w-8" aria-hidden="true"></span>О клубе</p>
      <h2 id="about-title" class="mt-3">Наша цель — научить плавать каждого ребёнка</h2>
      <p class="mt-5">У наших тренеров профильное образование в адаптивной физической культуре и спортивное плавательное прошлое. Поэтому они умеют найти путь к движению в воде и научить плавать даже детей с тяжёлыми нарушениями.</p>
      <p class="mt-4">Для каждого ребёнка составляем свой курс. Перед началом тренировок тестируем плавательные навыки и физическое развитие, чтобы видеть результат.</p>
      <h3 class="mt-8 font-sans text-lg font-semibold">Чем занимается клуб</h3>
      <ul class="mt-3 grid gap-2.5">
        {tasks.map((t) => (
          <li class="flex gap-3"><span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-foam text-sea"><Icon name="check" size={16} /></span>{t}</li>
        ))}
      </ul>
      <a href="/o-klube/" class="btn btn-secondary mt-8">Подробнее о клубе <Icon name="arrow" size={20} /></a>
    </div>
  </div>
</section>
