---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

const prices = await getCollection('prices');
const individual = prices.find((p) => p.id === 'individual')!.data;
const group = prices.find((p) => p.id === 'group')!.data;

// «от …» для индивидуальных: минимальная известная цена (если ни одной нет — «зависит от бассейна»)
const nums = individual.items.map((i) => i.price && parseInt(i.price)).filter((n): n is number => !!n);
const allKnown = nums.length === individual.items.length;
const individualPrice = allKnown ? `от ${Math.min(...nums)} руб.` : 'Цена зависит от бассейна';

const rows = [
  { title: 'Индивидуальное занятие', meta: individual.duration, price: individualPrice, icon: 'user' as const },
  ...group.items.map((g) => ({
    title: g.label ?? '',
    meta: [g.duration, g.place].filter(Boolean).join(', '),
    price: g.price ?? 'Цена уточняется',
    icon: g.icon ?? ('users' as const),
  })),
];
---

<section class="section pt-6" aria-labelledby="prices-title">
  <div class="container-page">
    <SectionHeading id="prices-title" title="Стоимость занятий" />
    <ul class="mt-10 grid gap-4 lg:grid-cols-3">
      {rows.map((r, i) => (
        <li class="card flex flex-col p-6 sm:p-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <div class="flex items-center gap-3">
            <span class="flex size-11 items-center justify-center rounded-2xl bg-foam text-sea"><Icon name={r.icon} /></span>
            <h3 class="text-lg">{r.title}</h3>
          </div>
          <p class="mt-3 flex items-center gap-2 text-ink-soft"><Icon name="clock" size={18} class="shrink-0" />{r.meta}</p>
          <p class="mt-auto pt-5 font-display text-2xl font-semibold text-ink">{r.price}</p>
        </li>
      ))}
    </ul>
    <a href="/bassejny/#ceny" class="btn btn-secondary mt-8">Все бассейны и цены <Icon name="arrow" size={20} /></a>
  </div>
</section>
