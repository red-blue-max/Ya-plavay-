---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Wave from '../components/Wave.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCoachesById, shortName } from '../lib/site';

const pools = await getCollection('pools');
const coaches = await getCoachesById();
const prices = await getCollection('prices');
const individual = prices.find((p) => p.id === 'individual')!.data;
const group = prices.find((p) => p.id === 'group')!.data;
const poolName = new Map(pools.map((p) => [p.id, p.data.name]));

const access = (a: boolean | 'partly' | null) =>
  a === true ? { text: 'Доступная среда', cls: 'bg-foam' } : a === 'partly' ? { text: 'Есть сложности с доступной средой', cls: 'bg-sun-soft' } : null;
const mapHref = (p: { mapLink?: string; address: string }) =>
  p.mapLink ?? `https://yandex.ru/maps/213/moscow/?text=${encodeURIComponent('Москва, ' + p.address.replace(/\s*\(.*\)/, ''))}`;
---

<Base
  title="Бассейны и цены"
  description="Адреса бассейнов в Москве, где проходят занятия клуба «Я Плаваю»: Лужники, Арктика, Качаловский и другие. Температура воды, доступная среда, тренеры и стоимость занятий."
>
  <PageHero title="Бассейны и цены" lead="Адреса бассейнов, в которых проходят наши тренировки, температура воды, доступная среда и тренеры.">
    <a href="#ceny" class="btn btn-secondary mt-8">Перейти к ценам <Icon name="down" size={20} /></a>
  </PageHero>

  <section class="pb-16 sm:pb-24" aria-labelledby="pools-title">
    <div class="container-page">
      <h2 id="pools-title" class="sr-only">Бассейны</h2>
      <ul class="grid gap-5 md:grid-cols-2">
        {pools.map((p, i) => {
          const a = access(p.data.accessible);
          const names = [...p.data.coaches.map((id) => coaches.get(id)?.name).filter(Boolean).map((n) => shortName(n!)), ...p.data.coachesOther];
          return (
            <li data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <article class="card flex h-full flex-col p-6 sm:p-8" aria-labelledby={`pool-${p.id}`}>
                <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                  <h3 id={`pool-${p.id}`}>{p.data.name}</h3>
                  {a && <span class:list={['chip shrink-0 text-xs', a.cls]}><Icon name="access" size={16} />{a.text}</span>}
                </div>
                <p class="mt-4 flex gap-2"><Icon name="pin" size={20} class="mt-0.5 shrink-0 text-sea" /><a href={mapHref(p.data)} rel="noopener" class="text-ink">{p.data.address}</a></p>
                <p class="mt-2 flex gap-2 text-ink-soft"><Icon name="metro" size={20} class="mt-0.5 shrink-0 text-lane" />м. {p.data.metro.join(', ')}</p>
                <p class="mt-2 flex gap-2 text-ink-soft"><Icon name="thermo" size={20} class="mt-0.5 shrink-0 text-coral" />{p.data.water}</p>
                <p class="mt-4">{p.data.about}</p>
                <p class="mt-auto pt-5 text-[0.95rem] text-ink-soft"><span class="font-semibold text-ink">{names.length > 1 ? 'Занятия проводят:' : 'Занятия проводит:'}</span> {names.join(', ')}</p>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <Wave class="text-foam" variant={3} />
  <section id="ceny" class="scroll-mt-20 bg-foam pt-8 pb-16 sm:pb-24" aria-labelledby="ceny-title">
    <div class="container-page">
      <SectionHeading id="ceny-title" title="Стоимость занятий" />
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <div class="card min-w-0 p-6 sm:p-8" data-reveal>
          <h3>{individual.title}</h3>
          <p class="mt-2 flex items-center gap-2 text-ink-soft"><Icon name="clock" size={18} />{individual.duration}</p>
          <table class="mt-5 w-full">
            <caption class="sr-only">Цены индивидуальных занятий по бассейнам</caption>
            <thead class="sr-only"><tr><th scope="col">Бассейн</th><th scope="col">Цена</th></tr></thead>
            <tbody class="divide-y divide-ink/8">
              {individual.items.map((it) => (
                <tr>
                  <th scope="row" class="py-3 pr-4 text-left font-normal">{poolName.get(it.pool!)}</th>
                  <td class:list={['py-3 text-right font-semibold whitespace-nowrap', !it.price && 'font-normal text-ink-soft']}>{it.price ?? 'уточняется'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="card min-w-0 p-6 sm:p-8" data-reveal style="--reveal-delay:90ms">
          <h3>{group.title}</h3>
          <ul class="mt-5 divide-y divide-ink/8">
            {group.items.map((g) => (
              <li class="flex items-start justify-between gap-4 py-4 first:pt-0">
                <span>
                  <span class="block font-semibold">{g.label}</span>
                  <span class="mt-1 block text-ink-soft">{[g.duration, g.place].filter(Boolean).join(', ')}</span>
                </span>
                <span class="font-display text-2xl font-semibold whitespace-nowrap">{g.price ?? 'уточняется'}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <Wave class="-mt-px rotate-180 text-foam" variant={1} />

  <LeadForm />
</Base>
