---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Wave from '../components/Wave.astro';
import LeadForm from '../components/LeadForm.astro';
import { photos } from '../lib/photos';
import { SIGNUP_ANCHOR } from '../lib/site';

const directions = await getCollection('directions');
const pools = new Map((await getCollection('pools')).map((p) => [p.id, p.data.name]));
const prices = await getCollection('prices');
const individual = prices.find((p) => p.id === 'individual')!.data;

const media: Record<string, { photo?: (typeof photos)[keyof typeof photos]; icon: 'user' | 'users' | 'heart' | 'drop' | 'wave' }> = {
  individualnye: { photo: photos.trenerVVode, icon: 'user' },
  gruppovye: { photo: photos.gruppa, icon: 'users' },
  halliwick: { photo: photos.naSpine, icon: 'heart' },
  parafridajving: { photo: photos.zaplyv, icon: 'drop' },
  watsu: { icon: 'wave' },
};
const tint = { sky: 'bg-sky-soft', foam: 'bg-foam', sun: 'bg-sun-soft' } as const;
const frame = { sky: 'sky', foam: 'foam', sun: 'sun' } as const;

const docs = [
  'Справка о допуске в бассейн (можно взять в поликлинике у педиатра)',
  'Справка от невролога о том, что оздоровительное плавание рекомендовано или не противопоказано',
];
const kit = ['Купальник или плавки', 'Шапочка для плавания', 'Очки для плавания', 'Полотенце', 'Сменная обувь для ребёнка и сопровождающего', 'Трусики или подгузники для плавания'];
---

<Base
  title="Занятия: индивидуальные, групповые, Halliwick, парафридайвинг, Watsu"
  description="Индивидуальные и групповые занятия плаванием для детей с ДЦП, РАС, ЗПР, синдромом Дауна, Halliwick-терапия для детей 2–10 лет, парафридайвинг и Watsu для взрослых. Для кого, как проходят, цены."
  ogImage={photos.gruppa.src}
>
  <PageHero title="Занятия" lead="На всех занятиях тренер в воде вместе с учениками. Тренировки проходят в дружелюбной атмосфере и основаны на естественных движениях человека в воде.">
    <nav aria-label="Направления" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {directions.map((d) => (
          <li><a href={`#${d.id}`} class="chip min-h-11 bg-white/85 px-4 font-semibold no-underline ring-1 ring-ink/5 hover:bg-white">{d.data.title}</a></li>
        ))}
      </ul>
    </nav>
  </PageHero>

  {directions.map((d, i) => {
    const m = media[d.id];
    const odd = i % 2 === 1;
    return (
      <section id={d.id} class:list={['scroll-mt-20 py-14 sm:py-20', odd && 'bg-foam']} aria-labelledby={`${d.id}-title`}>
        <div class="container-page grid items-start gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
          <div class:list={[odd && 'lg:order-2']} data-reveal>
            <span class:list={['flex size-14 items-center justify-center rounded-2xl text-sea', tint[d.data.accent]]}><Icon name={m.icon} size={28} /></span>
            <h2 id={`${d.id}-title`} class="mt-5">{d.data.title}</h2>

            <h3 class="mt-8 font-sans text-lg font-semibold text-sea">Для кого</h3>
            <p class="mt-2">{d.data.forWhom}</p>
            <p class="mt-3">{d.data.goal}</p>

            <h3 class="mt-8 font-sans text-lg font-semibold text-sea">Как проходит</h3>
            <ul class="mt-3 grid gap-3">
              {d.data.how.map((h) => (
                <li class="flex gap-3"><span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-white text-sea ring-1 ring-ink/10"><Icon name="check" size={16} /></span>{h}</li>
              ))}
            </ul>

            {d.data.benefits && (
              <>
                <h3 class="mt-8 font-sans text-lg font-semibold text-sea">Watsu помогает</h3>
                <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                  {d.data.benefits.map((b) => <li class="flex gap-2"><Icon name="drop" size={20} class="mt-0.5 shrink-0 text-aqua-deep" />{b}</li>)}
                </ul>
              </>
            )}
            {d.data.note && (
              <p class="mt-6 rounded-2xl bg-sun-soft p-4 text-[0.95rem]">
                {d.data.note} {d.data.noteLink && <a href={d.data.noteLink} rel="noopener">{new URL(d.data.noteLink).host}</a>}
              </p>
            )}
          </div>

          <aside class:list={['grid gap-6 lg:sticky lg:top-28', odd && 'lg:order-1']} aria-label={`Цена и запись: ${d.data.title}`}>
            {m.photo && <Photo src={m.photo.src} alt={m.photo.alt} ratio="4/5" frame={frame[d.data.accent]} position="attention" class="hidden sm:block" sizes="(min-width: 1024px) 34vw, 80vw" />}
            <div class="card p-6 sm:p-7" data-reveal>
              {d.id === 'individualnye' ? (
                <>
                  <p class="flex items-center gap-2 font-semibold"><Icon name="clock" size={20} class="text-sea" />{individual.duration}</p>
                  <table class="mt-4 w-full text-[0.95rem]">
                    <caption class="sr-only">Цены индивидуальных занятий по бассейнам</caption>
                    <tbody class="divide-y divide-ink/8">
                      {individual.items.map((it) => (
                        <tr>
                          <th scope="row" class="py-2 pr-3 text-left font-normal">{pools.get(it.pool!)}</th>
                          <td class:list={['py-2 text-right font-semibold whitespace-nowrap', !it.price && 'font-normal text-ink-soft']}>{it.price ?? 'уточняется'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </>
              ) : (
                <>
                  {d.data.duration && <p class="flex items-center gap-2 font-semibold"><Icon name="clock" size={20} class="text-sea" />{d.data.duration}</p>}
                  <p class="mt-3 font-display text-3xl font-semibold">{d.data.priceNote}</p>
                </>
              )}
              <a href={SIGNUP_ANCHOR} class="btn btn-primary mt-6 w-full" data-signup-direction={d.data.title}>Записаться</a>
            </div>
          </aside>
        </div>
      </section>
    );
  })}

  <Wave class="text-sky-soft" variant={2} />
  <section class="bg-sky-soft pt-8 pb-16 sm:pb-24" aria-labelledby="start-title">
    <div class="container-page">
      <p class="eyebrow"><span class="lane inline-block w-8" aria-hidden="true"></span>Дорогие родители</p>
      <h2 id="start-title" class="mt-3">Что нужно, чтобы начать заниматься</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="card p-6 sm:p-8" data-reveal>
          <span class="flex size-12 items-center justify-center rounded-2xl bg-foam text-sea"><Icon name="doc" /></span>
          <h3 class="mt-4">Справки</h3>
          <ul class="mt-4 grid gap-3">{docs.map((x) => <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-sea" />{x}</li>)}</ul>
        </div>
        <div class="card p-6 sm:p-8" data-reveal style="--reveal-delay:90ms">
          <span class="flex size-12 items-center justify-center rounded-2xl bg-foam text-sea"><Icon name="bag" /></span>
          <h3 class="mt-4">Что взять с собой</h3>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">{kit.map((x) => <li class="flex gap-3"><Icon name="check" size={20} class="mt-0.5 shrink-0 text-sea" />{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>
  <Wave class="-mt-px rotate-180 text-sky-soft" variant={1} />

  <LeadForm />
</Base>
